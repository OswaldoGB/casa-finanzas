# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para seed-dev y scripts verify-*. Debe coincidir con la URL de desarrollo.
SUPABASE_TEST_URL=https://xxxx.supabase.co
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de la app (para enlaces de recuperación de contraseña)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protege /api/cron/* (Vercel lo envía como Bearer)
CRON_SECRET=
# Web Push: la clave pública llega al navegador; las otras dos solo al servidor.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://tu-dominio.example
